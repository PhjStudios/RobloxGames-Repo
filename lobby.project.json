{
  "name": "Ant Tower Defense - Lobby",
  "tree": {
    "$className": "DataModel",
    "$ignoreUnknownInstances": true,

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$ignoreUnknownInstances": true,
      "$attributes": {
        "ATDPlaceRole": "Lobby"
      },

      "Shared": {
        "$path": "src/shared",
        "$ignoreUnknownInstances": true
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$ignoreUnknownInstances": true,

      "Server": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,

        "common": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true,

          "bootstrap": {
            "$className": "Folder",
            "$ignoreUnknownInstances": true,

            "Main": {
              "$path": "src/server/lobby/bootstrap/Main.server.luau"
            },

            "ServerBootstrap": {
              "$path": "src/server/common/bootstrap/ServerBootstrap.luau"
            },

            "Shutdown": {
              "$path": "src/server/common/bootstrap/Shutdown.luau"
            }
          },

          "networking": {
            "$path": "src/server/common/networking",
            "$ignoreUnknownInstances": true
          },

          "profile": {
            "$path": "src/server/common/profile",
            "$ignoreUnknownInstances": true
          },

          "rewards": {
            "$path": "src/server/match/rewards",
            "$ignoreUnknownInstances": true
          },

          "travel": {
            "$path": "src/server/common/travel",
            "$ignoreUnknownInstances": true
          }
        },

        "lobby": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true,

          "inventory": {
            "$path": "src/server/lobby/inventory",
            "$ignoreUnknownInstances": true
          },

          "acquisition": {
            "$path": "src/server/lobby/acquisition",
            "$ignoreUnknownInstances": true
          },

          "settings": {
            "$path": "src/server/lobby/settings",
            "$ignoreUnknownInstances": true
          },

          "party": {
            "$path": "src/server/lobby/party",
            "$ignoreUnknownInstances": true
          },

          "queue": {
            "$path": "src/server/lobby/queue",
            "$ignoreUnknownInstances": true
          },

          "travel": {
            "$path": "src/server/lobby/travel",
            "$ignoreUnknownInstances": true
          }
        }
      }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$ignoreUnknownInstances": true,

      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$ignoreUnknownInstances": true,

        "Client": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true,

          "common": {
            "$className": "Folder",
            "$ignoreUnknownInstances": true,

            "bootstrap": {
              "$className": "Folder",
              "$ignoreUnknownInstances": true,

              "Main": {
                "$path": "src/client/lobby/bootstrap/Main.client.luau"
              },

              "ClientBootstrap": {
                "$path": "src/client/common/bootstrap/ClientBootstrap.luau"
              }
            },

            "networking": {
              "$path": "src/client/common/networking",
              "$ignoreUnknownInstances": true
            },

            "ui": {
              "$path": "src/client/common/ui",
              "$ignoreUnknownInstances": true
            }
          },

          "lobby": {
            "$className": "Folder",
            "$ignoreUnknownInstances": true,

            "LobbyController": {
              "$path": "src/client/lobby/LobbyController.luau"
            },

            "ui": {
              "$path": "src/client/lobby/ui",
              "$ignoreUnknownInstances": true
            }
          }
        }
      }
    }
