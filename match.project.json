{
  "name": "Ant Tower Defense - Match",
  "tree": {
    "$className": "DataModel",
    "$ignoreUnknownInstances": true,

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$ignoreUnknownInstances": true,
      "$attributes": {
        "ATDPlaceRole": "Match"
      },

      "Shared": {
        "$path": "src/shared",
        "$ignoreUnknownInstances": true
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$ignoreUnknownInstances": true,

      "Server": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,

        "common": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true,

          "bootstrap": {
            "$className": "Folder",
            "$ignoreUnknownInstances": true,

            "Main": {
              "$path": "src/server/match/bootstrap/Main.server.luau"
            },

            "ServerBootstrap": {
              "$path": "src/server/common/bootstrap/ServerBootstrap.luau"
            },

            "Shutdown": {
              "$path": "src/server/common/bootstrap/Shutdown.luau"
            }
          },

          "networking": {
            "$path": "src/server/common/networking",
            "$ignoreUnknownInstances": true
          }
        },

        "match": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true,

          "base": {
            "$path": "src/server/match/base",
            "$ignoreUnknownInstances": true
          },

          "enemies": {
            "$path": "src/server/match/enemies",
            "$ignoreUnknownInstances": true
          },

          "maps": {
            "$path": "src/server/match/maps",
            "$ignoreUnknownInstances": true
          },

          "lifecycle": {
            "$path": "src/server/match/lifecycle",
            "$ignoreUnknownInstances": true
          },

          "roster": {
            "$path": "src/server/match/roster",
            "$ignoreUnknownInstances": true
          },

          "ready": {
            "$path": "src/server/match/ready",
            "$ignoreUnknownInstances": true
          },

          "waves": {
            "$path": "src/server/match/waves",
            "$ignoreUnknownInstances": true
          }
        }
      }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$ignoreUnknownInstances": true,

      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$ignoreUnknownInstances": true,

        "Client": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true,

          "common": {
            "$className": "Folder",
            "$ignoreUnknownInstances": true,

            "bootstrap": {
              "$className": "Folder",
              "$ignoreUnknownInstances": true,

              "Main": {
                "$path": "src/client/match/bootstrap/Main.client.luau"
              },

              "ClientBootstrap": {
                "$path": "src/client/common/bootstrap/ClientBootstrap.luau"
              }
            },

            "networking": {
              "$path": "src/client/common/networking",
              "$ignoreUnknownInstances": true
            }
          },

          "match": {
            "$className": "Folder",
            "$ignoreUnknownInstances": true,

            "base": {
              "$path": "src/client/match/base",
              "$ignoreUnknownInstances": true
            },

            "enemies": {
              "$path": "src/client/match/enemies",
              "$ignoreUnknownInstances": true
            },

            "waves": {
              "$path": "src/client/match/waves",
              "$ignoreUnknownInstances": true
            },

            "MatchReadyController": {
              "$path": "src/client/match/MatchReadyController.luau"
            },

            "MatchReadyView": {
              "$path": "src/client/match/MatchReadyView.luau"
            },

            "MatchReadyViewModel": {
              "$path": "src/client/match/MatchReadyViewModel.luau"
            }
          }
        }
      }
    }
  }
}
